# --- Models (any LiteLLM model id; nothing is hard-coded) ---
CHAT_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=...   # if CHAT_MODEL is a Claude model

# --- Auth (stand-ins for your app's login) ---
API_TOKEN=change-me          # shared demo token: can query ANY customer
# CUSTOMER_TOKENS=acme:tok-acme,globex:tok-globex   # per-customer tokens; when set, API_TOKEN is ignored
ADMIN_TOKEN=change-me-too

# --- Guardrails ---
MIN_RELEVANCE=0.30        # best chunk similarity below this -> fixed refusal, no LLM call. Tune with the eval.
MAX_ANSWER_TOKENS=400
RATE_LIMIT_PER_MIN=10
TOP_K=5
REFUSAL_MESSAGE=That isn't in your documents, so I can't answer it.
